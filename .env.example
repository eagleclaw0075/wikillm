# Optional. Copy this file to .env and edit it:   cp .env.example .env
#
# These are starting values. Everything here can also be set in the app under
# "Model settings", and whatever you save there wins over this file.
# Real environment variables with the same names win over .env.

# Where your OpenAI-compatible server lives. Common defaults:
#   LM Studio   http://localhost:1234/v1
#   Ollama      http://localhost:11434/v1
#   llama.cpp   http://localhost:8080/v1
#   vLLM        http://localhost:8000/v1
WIKILLM_BASE_URL=http://localhost:1234/v1

# Most local servers need no key. Leave empty unless yours asks for one.
WIKILLM_API_KEY=

# The model name exactly as your server lists it. Leave empty to pick one in the app.
WIKILLM_MODEL=

# Port for the WikiLLM page itself (http://localhost:8917/).
WIKILLM_PORT=8917
